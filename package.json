{
	"name": "@ielts/shared",
	"version": "1.0.0",
	"description": "A shared module that shares works across modules.",
	"homepage": "https://github.com/ielts-writing-org/ielts-shared#readme",
	"bugs": {
		"url": "https://github.com/ielts-writing-org/ielts-shared/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ielts-writing-org/ielts-shared.git"
	},
	"author": "IELTS WRITING ORG",
	"type": "module",
	"main": "./dist/_index.js",
	"types": "./dist/_index.d.ts",
	"exports": {
		".": {
			"types": "./dist/_index.d.ts",
			"import": "./dist/_index.js"
		},
		"./constants": {
			"types": "./dist/constants/_index.d.ts",
			"import": "./dist/constants/_index.js"
		},
		"./schemas": {
			"types": "./dist/schemas/_index.d.ts",
			"import": "./dist/schemas/_index.js"
		},
		"./utils/math": {
			"types": "./dist/utils/math.utils.d.ts",
			"import": "./dist/utils/math.utils.js"
		},
		"./utils/essay": {
			"types": "./dist/utils/essay.utils.d.ts",
			"import": "./dist/utils/essay.utils.js"
		}
	},
	"scripts": {
		"check": "tsc --noEmit",
		"build": "tsc -p tsconfig.build.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "npm run build",
		"postinstall": "npm run build",
		"test": "npm run test:unit -- --run",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"zod": "^4.4.3"
	}
}
