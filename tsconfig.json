{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"verbatimModuleSyntax": true,
		"rootDir": "./src",
		"outDir": "./dist",
		"declaration": true
	},
	"include": ["./src/**/*.ts", "./src/**/*.d.ts"]
}
